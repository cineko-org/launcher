#!/usr/bin/env bash
set -euo pipefail

object_path() {
  local key=""
  local argument
  local previous=""
  for argument in "$@"; do
    if [[ "$previous" == "--key" ]]; then key="$argument"; fi
    previous="$argument"
  done
  if [[ -z "$key" ]]; then
    for argument in "$@"; do
      if [[ "$argument" == s3://* ]]; then key="${argument#s3://*/}"; fi
    done
  fi
  printf '%s/%s' "$FAKE_OBJECT_ROOT" "$key"
}

if [[ " $* " == *" s3api head-object "* ]]; then
  object="$(object_path "$@")"
  test -f "$object"
  checksum="$(openssl dgst -sha256 -binary "$object" | openssl base64 -A)"
  checksum_hex="$(sha256sum "$object" | awk '{print $1}')"
  jq -cn \
    --arg checksum "$checksum" \
    --arg checksum_hex "$checksum_hex" \
    --argjson size "$(stat -c '%s' "$object")" \
    '{ContentLength:$size,ChecksumSHA256:$checksum,Metadata:{sha256:$checksum_hex}}'
  exit 0
fi

if [[ " $* " == *" s3api put-object "* ]]; then
  object="$(object_path "$@")"
  body=""
  previous=""
  for argument in "$@"; do
    if [[ "$previous" == "--body" ]]; then body="$argument"; fi
    previous="$argument"
  done
  mkdir -p "$(dirname "$object")"
  if [[ -f "$object" ]]; then exit 1; fi
  if [[ -n "${FAKE_PUT_RACE_MARKER:-}" && ! -f "$FAKE_PUT_RACE_MARKER" ]]; then
    cp "$body" "$object"
    touch "$FAKE_PUT_RACE_MARKER"
    exit 1
  fi
  cp "$body" "$object"
  exit 0
fi

exit 2
